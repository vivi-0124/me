{
  "name": "setlist-review",
  "version": "0.1.0",
  "private": true,
  "description": "ライブのセトリと MC に、ファン仲間と1項目ずつコメントできる Web アプリ",
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && vite",
    "build": "vite build",
    "typecheck": "vue-tsc -b",
    "test": "node --test tests/*.test.ts",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {
    "@lucide/vue": "^1.60.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "hono": "^4.13.13",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9"
  }
}
