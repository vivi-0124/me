{
  "name": "setlist-review",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // 画面は Vue の SPA。知らないパスは index.html を返す
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // /e/* は LINE や X 用にタイトルを差し込むので Worker を先に通す
    "run_worker_first": ["/api/*", "/e/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "setlist-review",
      "database_id": "b0c22edc-4c2d-4863-8c3d-d9b2ba6bf4da"
    }
  ]
}
